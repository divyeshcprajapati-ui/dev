<div class="b2b-quote-button-wrapper" style="margin: 15px 0;">
  <button type="button" id="b2b-add-to-quote-btn" class="button button--secondary" style="
    width: 100%;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    {% unless request.design_mode %}display: none;{% endunless %}
    background-color: {{ block.settings.btn_bg_color }};
    color: {{ block.settings.btn_text_color }};
    border: 1px solid {{ block.settings.btn_border_color }};
  ">
    {{ block.settings.btn_label }}
  </button>
</div>

<!-- Quotation Request Modal -->
<div id="b2b-quote-modal" class="b2b-modal-overlay" style="display: none;">
  <div class="b2b-modal-content">
    <div class="b2b-modal-header">
      <h3>Request a Quote</h3>
      <button type="button" class="b2b-modal-close">&times;</button>
    </div>
    
    <form id="b2b-quote-form">
      <input type="hidden" name="product_name" value="{{ product.title }}">
      <input type="hidden" name="original_price" value="{{ product.price | money_without_currency }}">
      <input type="hidden" name="shop_domain" value="{{ shop.permanent_domain }}">

      <div id="b2b-quote-success-banner" style="display: none; padding: 16px; background-color: #dcfce7; color: #166534; border-radius: 8px; margin: 24px; font-weight: 600; text-align: center;">
        Quote request submitted successfully!
      </div>

      <div class="b2b-modal-body">
        <div class="b2b-product-summary">
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}">
          <div>
            <strong>{{ product.title }}</strong>
            <p>Original Price: {{ product.price | money }}</p>
          </div>
        </div>

        <div class="b2b-form-grid">
          <div class="b2b-form-field">
            <label for="b2b-quote-qty">Quantity *</label>
            <input type="number" id="b2b-quote-qty" name="quantity" min="1" value="100" required>
          </div>
          <div class="b2b-form-field">
            <label for="b2b-quote-price">Target Price per Unit (USD) *</label>
            <input type="number" id="b2b-quote-price" name="quoted_price" step="0.01" value="{{ product.price | money_without_currency }}" required>
          </div>
        </div>

        <div class="b2b-form-field">
          <label for="b2b-quote-name">Your Name *</label>
          <input type="text" id="b2b-quote-name" name="customer_name" value="{{ customer.name }}" required>
        </div>

        <div class="b2b-form-field">
          <label for="b2b-quote-email">Your Email *</label>
          <input type="email" id="b2b-quote-email" name="customer_email" value="{{ customer.email }}" required>
        </div>

        <div class="b2b-form-field">
          <label for="b2b-quote-company">Company Name *</label>
          <input type="text" id="b2b-quote-company" name="company_name" value="{{ customer.default_address.company }}" required>
        </div>

        <div class="b2b-form-field">
          <label for="b2b-quote-location">Company Location / Address *</label>
          <input type="text" id="b2b-quote-location" name="company_location" value="{{ customer.default_address.address1 }}, {{ customer.default_address.city }}, {{ customer.default_address.province }}, {{ customer.default_address.country }}" required>
        </div>

        <div class="b2b-form-field">
          <label for="b2b-quote-shipping">Shipping Address *</label>
          <textarea id="b2b-quote-shipping" name="shipping_address" rows="2" required>{{ customer.default_address.address1 }}, {{ customer.default_address.city }}, {{ customer.default_address.province }}, {{ customer.default_address.zip }}, {{ customer.default_address.country }}</textarea>
        </div>

        <div class="b2b-form-field">
          <label for="b2b-quote-billing">Billing Address</label>
          <textarea id="b2b-quote-billing" name="billing_address" rows="2" placeholder="Same as shipping address if left empty"></textarea>
        </div>
      </div>

      <div class="b2b-modal-footer">
        <button type="button" class="btn-cancel b2b-modal-close-btn">Cancel</button>
        <button type="submit" class="btn-submit">Submit Request</button>
      </div>
    </form>
  </div>
</div>

<style>
  .b2b-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .b2b-modal-content {
    background: #fff;
    border-radius: 12px;
    width: 100%;
    max-width: 540px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    color: #333;
  }
  .b2b-modal-header {
    padding: 16px 24px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .b2b-modal-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }
  .b2b-modal-close {
    border: none;
    background: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
  }
  .b2b-modal-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .b2b-product-summary {
    display: flex;
    gap: 16px;
    align-items: center;
    background: #f8f9fa;
    padding: 12px;
    border-radius: 8px;
  }
  .b2b-product-summary img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #ddd;
  }
  .b2b-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .b2b-form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .b2b-form-field label {
    font-size: 13px;
    font-weight: 600;
    color: #4b5563;
  }
  .b2b-form-field input, .b2b-form-field textarea {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    width: 100%;
    box-sizing: border-box;
  }
  .b2b-modal-footer {
    padding: 16px 24px;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }
  .b2b-modal-footer button {
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    border: none;
  }
  .btn-cancel {
    background: #f3f4f6;
    color: #4b5563;
  }
  .btn-submit {
    background: #1a1a1a;
    color: #fff;
  }
</style>

<script>
  (function() {
    const API_BASE_URL = 'https://onshore-embezzle-skinny.ngrok-free.dev';
    const shopDomain = '{{ shop.permanent_domain }}';
    const customerEmail = '{{ customer.email }}';

    async function initQuoteButton() {
      const btn = document.getElementById('b2b-add-to-quote-btn');
      const modal = document.getElementById('b2b-quote-modal');
      const closeBtns = document.querySelectorAll('.b2b-modal-close, .b2b-modal-close-btn');
      const form = document.getElementById('b2b-quote-form');

      if (!btn || !modal) return;

      console.log('B2B Quote Block loaded. Customer:', customerEmail, 'Shop:', shopDomain);

      // Force display in Shopify design mode (Theme Editor) so the merchant can see and customize the button
      const isDesignMode = {% if request.design_mode %}true{% else %}false{% endif %};
      if (isDesignMode) {
        console.log('Force displaying quote button in Shopify Theme Editor design mode.');
        btn.style.display = 'block';
      }

      // Check settings and B2B user eligibility
      try {
        console.log('Fetching quote settings from:', `${API_BASE_URL}/api/b2b/quote-settings?shop=${shopDomain}`);
        const res = await fetch(`${API_BASE_URL}/api/b2b/quote-settings?shop=${shopDomain}`, {
          headers: { 'ngrok-skip-browser-warning': 'true' }
        });
        const result = await res.json();
        console.log('Quote settings response:', result);

        if (result.success && result.data) {
          const settings = result.data;
          const isProductPageEnabled = settings.productPage === 'true' || settings.productPage === true;
          const notLoggedInAllowed = settings.notLoggedIn === 'true' || settings.notLoggedIn === true;

          // Only show the button if enabled in settings
          if (isProductPageEnabled) {
            if (customerEmail || notLoggedInAllowed) {
              console.log('Conditions met. Displaying B2B Quote Button.');
              btn.style.display = 'block';
            } else {
              console.log('Quote button hidden: Customer is not logged in and guests are not allowed.');
              if (!isDesignMode) btn.style.display = 'none';
            }
          } else {
            console.log('Quote button hidden: Product page display is disabled in settings.');
            if (!isDesignMode) btn.style.display = 'none';
          }
        }
      } catch (e) {
        console.error('Failed to load quote settings:', e);
      }

      // Show Modal
      btn.addEventListener('click', function() {
        modal.style.display = 'flex';
      });

      // Hide Modal
      closeBtns.forEach(c => {
        c.addEventListener('click', function() {
          modal.style.display = 'none';
        });
      });

      // Submit form
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const submitBtn = form.querySelector('.btn-submit');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        const formData = new FormData(form);
        const payload = {};
        formData.forEach((val, key) => {
          payload[key] = val;
        });

        // Conversions
        payload.original_price = parseFloat(payload.original_price);
        payload.quoted_price = parseFloat(payload.quoted_price);
        payload.quantity = parseInt(payload.quantity);
        payload.subtotal = payload.quoted_price * payload.quantity;
        if (!payload.billing_address) {
          payload.billing_address = payload.shipping_address;
        }

        try {
          const response = await fetch(`${API_BASE_URL}/api/b2b/quotes`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'ngrok-skip-browser-warning': 'true'
            },
            body: JSON.stringify(payload)
          });
          const data = await response.json();

          if (response.ok && data.success) {
            const successBanner = document.getElementById('b2b-quote-success-banner');
            if (successBanner) {
              successBanner.style.display = 'block';
              form.querySelector('.b2b-modal-body').style.display = 'none';
              form.querySelector('.b2b-modal-footer').style.display = 'none';
              setTimeout(() => {
                modal.style.display = 'none';
                successBanner.style.display = 'none';
                form.querySelector('.b2b-modal-body').style.display = 'flex';
                form.querySelector('.b2b-modal-footer').style.display = 'flex';
                form.reset();
              }, 3000);
            }
          } else {
            alert('Failed to submit quote: ' + (data.message || 'Unknown error'));
          }
        } catch (err) {
          console.error(err);
          alert('An error occurred submitting the quote.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Request';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initQuoteButton);
    } else {
      initQuoteButton();
    }
  })();
</script>

{% schema %}
{
  "name": "Add to Quote Button",
  "target": "section",
  "settings": [
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Add to Quote" },
    { "type": "color", "id": "btn_bg_color", "label": "Button Background Color", "default": "#1a1a1a" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#ffffff" },
    { "type": "color", "id": "btn_border_color", "label": "Button Border Color", "default": "#1a1a1a" }
  ]
}
{% endschema %}
