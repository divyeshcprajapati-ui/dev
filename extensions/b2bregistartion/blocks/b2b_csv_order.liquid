{% render 'b2b_i18n_script' %}
<div class="b2b-csv-order" style="max-width:960px;margin:24px auto;padding:24px;background:#fff;border:1px solid #e1e3e5;border-radius:12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
  <h2 id="b2b-csv-title" style="margin:0 0 8px 0;font-size:22px;color:#111827;">{{ block.settings.title }}</h2>
  <p id="b2b-csv-desc" style="margin:0 0 16px 0;color:#64748b;font-size:14px;">Upload a CSV file with columns <code>sku,quantity</code> to validate and add wholesale items to your cart.</p>
  <div id="b2b-csv-status" style="display:none;padding:12px;border-radius:8px;margin-bottom:14px;font-size:14px;font-weight:600;"></div>

  <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:16px;">
    <input id="b2b-csv-file" type="file" accept=".csv,text/csv" style="padding:8px;border:1px solid #cbd5e1;border-radius:8px;">
    <button id="b2b-csv-validate" type="button" style="padding:10px 18px;background:#111827;color:#fff;border:none;border-radius:8px;font-weight:600;cursor:pointer;">Validate CSV</button>
    <button id="b2b-csv-add-cart" type="button" style="display:none;padding:10px 18px;background:#008060;color:#fff;border:none;border-radius:8px;font-weight:700;cursor:pointer;">Add Valid Items to Cart</button>
  </div>

  <div id="b2b-csv-preview"></div>
</div>

<script>
(function() {
  const API_BASE = '{{ block.settings.api_base_url }}'.replace(/\/$/, '');
  const shopDomain = '{{ shop.permanent_domain }}';
  const activeLocale = '{{ request.locale.iso_code }}';
  let validatedItems = [];

  if (window.B2B_I18N) {
    window.B2B_I18N.load(API_BASE, shopDomain, activeLocale, 'csv').then(t => {
      if (t.title) document.getElementById('b2b-csv-title').textContent = t.title;
      if (t.instructions) document.getElementById('b2b-csv-desc').textContent = t.instructions;
      if (t.validate_button) document.getElementById('b2b-csv-validate').textContent = t.validate_button;
      if (t.add_to_cart) document.getElementById('b2b-csv-add-cart').textContent = t.add_to_cart;
    });
  }

  function setStatus(msg, isError) {
    const el = document.getElementById('b2b-csv-status');
    el.style.display = 'block';
    el.style.background = isError ? '#fee2e2' : '#dcfce7';
    el.style.color = isError ? '#991b1b' : '#166534';
    el.textContent = msg;
  }

  document.getElementById('b2b-csv-validate').addEventListener('click', async function() {
    const fileInput = document.getElementById('b2b-csv-file');
    if (!fileInput.files || !fileInput.files[0]) { setStatus('Please select a CSV file first.', true); return; }
    const text = await fileInput.files[0].text();
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    const skus = [];
    lines.forEach((line, idx) => {
      const [rawSku, rawQty] = line.split(',').map(s => (s || '').trim().replace(/^"|"$/g, ''));
      if (idx === 0 && rawSku.toLowerCase() === 'sku') return;
      if (rawSku) skus.push({ sku: rawSku, quantity: Math.max(1, parseInt(rawQty, 10) || 1) });
    });

    if (skus.length === 0) { setStatus('No valid SKU rows found in CSV.', true); return; }

    try {
      const res = await fetch(`${API_BASE}/api/b2b/ordering/lookup-skus`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Shop-Domain': shopDomain, 'ngrok-skip-browser-warning': 'true' },
        body: JSON.stringify({ shop: shopDomain, skus })
      });
      const json = await res.json();
      if (!res.ok || !json.success) { setStatus(json.message || 'CSV validation failed.', true); return; }

      const rows = json.data || [];
      validatedItems = rows.filter(r => r.found);
      document.getElementById('b2b-csv-preview').innerHTML = `
        <table style="width:100%;border-collapse:collapse;font-size:14px;">
          <thead><tr style="border-bottom:2px solid #f1f5f9;text-align:left;color:#64748b;"><th style="padding:8px;">SKU</th><th style="padding:8px;">Product</th><th style="padding:8px;">Qty</th><th style="padding:8px;">Status</th></tr></thead>
          <tbody>${rows.map(r => `
            <tr style="border-bottom:1px solid #f1f5f9;">
              <td style="padding:8px;">${r.requested_sku}</td>
              <td style="padding:8px;">${r.found ? r.product_title : '—'}</td>
              <td style="padding:8px;">${r.quantity}</td>
              <td style="padding:8px;color:${r.found ? '#166534' : '#991b1b'};font-weight:600;">${r.found ? 'Valid ($' + Number(r.price).toFixed(2) + ')' : 'Not Found'}</td>
            </tr>`).join('')}
          </tbody>
        </table>`;
      document.getElementById('b2b-csv-add-cart').style.display = validatedItems.length > 0 ? 'inline-block' : 'none';
      setStatus(`Validated ${validatedItems.length} of ${rows.length} SKU row(s).`, validatedItems.length === 0);
    } catch (e) {
      setStatus('Error validating CSV.', true);
    }
  });

  document.getElementById('b2b-csv-add-cart').addEventListener('click', async function() {
    if (validatedItems.length === 0) return;
    const res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: validatedItems.map(i => ({ id: Number(i.variant_id), quantity: i.quantity })) })
    });
    if (res.ok) {
      setStatus('Added valid CSV items to cart! Redirecting...', false);
      setTimeout(() => { window.location.href = '/cart'; }, 800);
    } else {
      setStatus('Failed to add items to cart.', true);
    }
  });
})();
</script>

{% schema %}
{
  "name": "B2B CSV Bulk Order",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "CSV Bulk Order Upload" },
    { "type": "text", "id": "api_base_url", "label": "App Backend URL", "default": "https://onshore-embezzle-skinny.ngrok-free.dev" }
  ]
}
{% endschema %}
