<script>
(function() {
  if (window.B2B_I18N) return;
  window.B2B_I18N = {
    async load(apiBase, shopDomain, locale, section) {
      const cleanLocale = (locale || 'en').toLowerCase().split('-')[0];
      if (!apiBase || !shopDomain || cleanLocale === 'en') return {};
      const cacheKey = `b2b_i18n_${shopDomain}_${cleanLocale}`;
      try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Date.now() < parsed.expiresAt) {
            return (parsed.data && parsed.data[section]) || {};
          }
        }
      } catch (_) {}

      try {
        const res = await fetch(`${apiBase.replace(/\/$/, '')}/api/b2b/translations?locale=${encodeURIComponent(cleanLocale)}&shop=${encodeURIComponent(shopDomain)}`, {
          headers: { 'X-Shop-Domain': shopDomain, 'ngrok-skip-browser-warning': 'true' }
        });
        const json = await res.json();
        const localeMap = (json && json.success && json.data && json.data.translations && json.data.translations[cleanLocale]) || {};
        try {
          sessionStorage.setItem(cacheKey, JSON.stringify({ data: localeMap, expiresAt: Date.now() + 5 * 60 * 1000 }));
        } catch (_) {}
        return localeMap[section] || {};
      } catch (_) {
        return {};
      }
    }
  };
})();
</script>
